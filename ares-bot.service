[Unit]
Description=Ares Alpaca crypto paper trading bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=jzewdu
Group=jzewdu
WorkingDirectory=/home/jzewdu/ares_trading_bot
EnvironmentFile=/home/jzewdu/ares_trading_bot/.env
Environment=ARES_STATE_PATH=/var/lib/ares/ares_state.sqlite3
StateDirectory=ares
ExecStart=/home/jzewdu/ares_trading_bot/.venv/bin/gunicorn --workers 1 --threads 4 --bind 127.0.0.1:8080 app:app
Restart=on-failure
RestartSec=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=/var/lib/ares

[Install]
WantedBy=multi-user.target
