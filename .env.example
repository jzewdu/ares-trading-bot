# Paper-trading credentials only. Never put live keys in this file.
ALPACA_API_KEY=
ALPACA_API_SECRET=
ALPACA_PAPER=true

# Dashboard login. Both must be set or the app answers 503.
ARES_UI_USER=ares
ARES_UI_PASSWORD=change-this-to-a-long-random-password
ARES_BIND=127.0.0.1

# One instrument. The desk owns BTC while it is not braked.
UNIVERSE=BTC
BARS_DAYS=120

# The rule, measured on closed 4h bars:
#   long  - the close is above (200-bar EMA - BTC_BRAKE_ATR * ATR)
#   brake - the close is below that level; sell and wait
BTC_EMA_BARS=200
BTC_BRAKE_ATR=2.0
# After a brake exit, how far (in ATRs) price must reclaim above the brake
# before a new position is bought. Stops a market chopping across the line
# from charging 50bp of fees per oscillation.
BTC_REARM_ATR=3.0

# Risk. A 2% risk budget against an 8-ATR stop puts roughly a quarter to half
# of equity into BTC. Positions are capped at 50% of equity each and 50% total.
RISK_PCT=0.02
MAX_POSITIONS=1
MAX_POSITION_PCT=0.5
MAX_EXPOSURE_PCT=0.5
MIN_NOTIONAL=25
MAX_SPREAD=0.0015
ENTRY_COOLDOWN_MIN=60
MAX_DAILY_LOSS_PCT=0.03
MAX_SIGNAL_DRIFT_ATR=2.0
# Alpaca's BTC print feed can trail the clock by minutes on a slow link.
MAX_PRINT_AGE_SEC=900

# Exits. The brake is the normal exit; TREND_STOP_ATR is the catastrophe stop.
# TRAIL_ATR=0 disables trailing (it turned one trend into a dozen round trips).
TRAIL_ATR=0
TREND_STOP_ATR=8.0
TREND_TARGET_ATR=400
TREND_MAX_DAYS=365

POLL_SECONDS=300
# Optional: override the launch baseline. 0 means "use broker equity".
START_EQUITY=0
