# Copy to .env, fill in FRESH PAPER-trading credentials, then: chmod 600 .env
# systemd loads this via EnvironmentFile=. The Python code does not parse it,
# so a manual run needs: set -a; source .env; set +a

# Alpaca paper account. Never use live keys here.
ALPACA_API_KEY=
ALPACA_API_SECRET=
ALPACA_PAPER=true

# Dashboard login. Both must be set or the dashboard answers 503.
ARES_UI_USER=ares
ARES_UI_PASSWORD=change-this-to-a-long-random-password

# Bind locally. Setting ARES_TLS_CERT + ARES_TLS_KEY is required to bind
# beyond localhost; do not expose this dashboard to the internet.
ARES_BIND=127.0.0.1
# ARES_TLS_CERT=/etc/ares/cert.pem
# ARES_TLS_KEY=/etc/ares/key.pem

# Risk and cadence caps (defaults shown).
MAX_PAIRS=56
MAX_POSITIONS=5
MAX_POSITION_PCT=0.03
MAX_TOTAL_EXPOSURE_PCT=0.15
MAX_DAILY_LOSS_PCT=0.03
POLL_SECONDS=300

# ARES_STATE_PATH=ares_state.sqlite3
