# Paper-trading credentials only. Never put live keys in this file.
ALPACA_API_KEY=
ALPACA_API_SECRET=
ALPACA_PAPER=true

# Dashboard login. Both must be set or the app answers 503.
ARES_UI_USER=ares
ARES_UI_PASSWORD=change-this-to-a-long-random-password
ARES_BIND=127.0.0.1
# 8080 is usually the SSH tunnel to the Pi's copy; the local desk uses 8090.
ARES_PORT=8090
# Absolute under systemd (/var/lib/ares/ares_state.sqlite3): the unit's
# ProtectHome=read-only blocks a relative path sitting next to the code.
# systemd also reads this file as EnvironmentFile, so a restart — not a HUP —
# is what applies an edit here.
ARES_STATE_PATH=ares_state.sqlite3

# The book. Eight majors, four positions at a time. A single coin left the desk
# idle for months, because the slow rule only fires a few times a year per name.
UNIVERSE=BTC,ETH,SOL,LINK,AVAX,DOGE,LTC,BCH

# Candle unit. This is the setting that decides whether the 200-bar line is a
# 200-DAY trend or a 33-day one. Daily is measured; hourly lost money live.
BAR_TIMEFRAME=1Day
BARS_DAYS=800

# The rule:
#   long  - the close is above (200-bar EMA - BTC_BRAKE_ATR * ATR)
#   brake - the close is below that level; sell and wait for a re-arm
BTC_EMA_BARS=200
BTC_BRAKE_ATR=3.0
# After ANY exit, how far (in ATRs) price must reclaim above the brake before a
# new position is bought. This is not cosmetic: without it the live account
# sold at 81,124 and re-bought at 81,290 ten minutes later.
BTC_REARM_ATR=1.5

# Risk. 2% of equity per position against an 8-ATR catastrophe stop; the brake
# is the normal exit. Four positions, 50% of equity at most.
RISK_PCT=0.02
MAX_POSITIONS=4
MAX_POSITION_PCT=0.5
MAX_EXPOSURE_PCT=0.5
MIN_NOTIONAL=25
# Wide spreads are the fee that does not show up on the ticket. Thin pairs on
# Alpaca routinely quote 0.3-0.6% and are refused by this gate.
MAX_SPREAD=0.0015
ENTRY_COOLDOWN_MIN=60
MAX_DAILY_LOSS_PCT=0.03
MAX_SIGNAL_DRIFT_ATR=2.0
MAX_PRINT_AGE_SEC=900

# Exits. The brake is the exit; TRAIL_ATR=0 disables trailing. The time stop is
# deliberately longer than a bitcoin cycle so it cannot cut a winning hold.
TRAIL_ATR=0
TREND_STOP_ATR=8.0
TREND_TARGET_ATR=400
TREND_MAX_DAYS=3650

POLL_SECONDS=300
# Optional: override the launch baseline. 0 means "use broker equity".
START_EQUITY=0
