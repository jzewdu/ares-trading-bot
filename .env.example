# Paper-trading credentials only. Never put live keys in this file.
ALPACA_API_KEY=
ALPACA_API_SECRET=
ALPACA_PAPER=true

# Dashboard login. Both must be set or the app answers 503.
ARES_UI_USER=ares
ARES_UI_PASSWORD=change-this-to-a-long-random-password
ARES_BIND=127.0.0.1

# Long-only spot universe. Alpaca cannot short crypto, so downtrends are
# stood aside rather than traded.
UNIVERSE=BTC,ETH,SOL,LINK,AVAX,XRP,ADA,DOT,LTC,BCH,UNI,AAVE
BARS_DAYS=90

# Regime thresholds on closed 4h bars.
# Trend: ADX and efficiency must both confirm directional persistence.
TREND_ADX=25
TREND_ER=0.30
TREND_SPREAD_PCT=0.35
# Range: directionless and wide enough for a fade to have room.
RANGE_ADX=22
RANGE_ER=0.22
RANGE_MIN_WIDTH=1.5
RANGE_RSI=35

# Risk. 0.0075 = 0.75% of equity lost if the stop is hit, before the
# learner's multiplier. Positions are capped at 25% of equity each and 75%
# in total; 0.0015 = a 0.15% spot spread gate.
RISK_PCT=0.0075
MAX_POSITIONS=4
MAX_POSITION_PCT=0.25
MAX_EXPOSURE_PCT=0.75
MIN_NOTIONAL=25
MAX_SPREAD=0.0015
ENTRY_COOLDOWN_MIN=60
MAX_DAILY_LOSS_PCT=0.03

# Exits.
TRAIL_ATR=4.5
TREND_STOP_ATR=3.0
TREND_TARGET_ATR=9.0
TREND_MAX_DAYS=20
RANGE_STOP_ATR=2.0
RANGE_MAX_DAYS=6
# mid = middle Bollinger band (higher hit rate); upper = far band (more R).
RANGE_TARGET=mid

POLL_SECONDS=300
# Optional: override the launch baseline. 0 means "use broker equity".
START_EQUITY=0
