[TEMPLATE]
# Use fresh PAPER-trading credentials only. Never use live keys in this file.
ALPACA_API_KEY=
ALPACA_API_SECRET=
ALPACA_PAPER=true

# Set both before enabling the dashboard on your home network.
ARES_UI_USER=ares
ARES_UI_PASSWORD=change-this-to-a-long-random-password
ARES_BIND=127.0.0.1

# Delta-neutral carry book. Notional is split equally across slots; each pair
# is long that notional on Alpaca spot and short the same on a Hyperliquid perp.
DN_UNIVERSE=LINK,BTC,ETH
DN_SLOTS=3
DN_NOTIONAL_PCT=0.60
DN_MARGIN_PCT=0.25
DN_ENTER_APR=2.0
DN_EXIT_APR=-3.0
DN_MAX_PREMIUM=0.02

# Equity floor: entries pause for the rest of the UTC day beyond this loss.
MAX_DAILY_LOSS_PCT=0.03
POLL_SECONDS=300
